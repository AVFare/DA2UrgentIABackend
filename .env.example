# Seguridad
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=60

# PostgreSQL
POSTGRES_PASSWORD=postgres
USERS_DB_PASSWORD=users_pass
TICKETS_DB_PASSWORD=tickets_pass

# MongoDB
MONGO_ROOT_PASSWORD=mongo
CLASSIFICATION_DB_PASSWORD=classification_pass
NOTIFICATIONS_DB_PASSWORD=notifications_pass
REPORTING_DB_PASSWORD=reporting_pass

# RabbitMQ (consola de administracion: http://localhost:15672)
# Sin caracteres especiales: el Compose los arma en RABBITMQ_URL (amqp://usuario:clave@rabbitmq:5672)
RABBITMQ_USER=urgentia
RABBITMQ_PASSWORD=rabbit_pass

# Mail de notification-service. "simulado" solo escribe un log; "real" manda por SMTP (Gmail).
# SMTP_PASSWORD es una contraseña de aplicación de Google: va solo en el .env, nunca en el repo.
# Todos los mails van a EMAIL_DESTINO_DEMO, con el destinatario original en el asunto.
EMAIL_PROVIDER=simulado
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DESTINO_DEMO=

# IA
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=5000
PROMPT_VERSION=full

# Integración
CLASSIFICATION_TIMEOUT_MS=7000
LOG_LEVEL=INFO

# Front (orígenes que el gateway acepta por CORS, separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173