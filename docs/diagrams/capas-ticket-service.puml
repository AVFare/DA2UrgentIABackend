@startuml capas-ticket-service
title UrgentIA - ticket-service: arquitectura hexagonal (puertos y adaptadores)

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  RoundCorner 8
}
left to right direction

actor "api-gateway\n(JWT -> X-User-Id,\nX-User-Rol)" as gw
queue "RabbitMQ\ntickets.clasificaciones" as qin

rectangle "**Adaptadores de entrada**\n(infrastructure)\n\nrest: CorrelationIdFilter, TicketController,\nGlobalExceptionHandler, HealthController\nsoap: TicketsEndpoint\nmessaging: ConsumidorDeClasificaciones\n+ ManejadorDeClasificaciones (ACL)" as entrada #E3F2FD

rectangle "**Puertos de entrada**\n(application.port.in)\n\nCrearTicketUseCase\nAsignarTicketUseCase\nCambiarEstadoUseCase\nReclasificarTicketUseCase\nConsultarTicketsUseCase\nAplicarClasificacionUseCase" as pin #FFF3E0

rectangle "**Aplicacion** (sin Spring)\n(application.service)\n\nCrearTicketService\nAsignarTicketService\nCambiarEstadoService\nReclasificarTicketService\nConsultarTicketsService\nAplicarClasificacionService\nModoClasificacion (sync | async)\n\n<i>orquestan, no deciden</i>" as app #FFF3E0

rectangle "**Dominio** (Java puro)\n(domain)\n\nTicket (Aggregate Root)\nClasificacion, Sla, TicketId (Value Objects)\nPrioridadStrategy / MatrizItilStrategy\nTicketFactory\nDomainEvent (TicketCreado, ...)\n\n<i>aca viven las reglas de la seccion 8</i>" as dom #E8F5E9

rectangle "**Puertos de salida**\n(application.port.out)\n\nTicketRepository\nClasificadorPort\nEventPublisherPort\nSolicitudDeClasificacionPort\nMensajesProcesadosPort" as pout #FFF3E0

rectangle "**Adaptadores de salida**\n(infrastructure)\n\nJpaTicketRepositoryAdapter, JpaMensajesProcesadosAdapter\nClassificationHttpClient + ACL (sync y reclasificacion)\nOutboxEventPublisherAdapter\nOutboxSolicitudDeClasificacionAdapter\n(guardan en la tabla outbox, en la misma transaccion)\nPublicadorDelOutbox + EnviadorRabbit\n(publisher confirms, reintentos)" as salida #E3F2FD

database "PostgreSQL\ntickets_db" as db
node "classification-service\n:8082" as ia
queue "RabbitMQ\nurgentia.eventos\nurgentia.clasificacion" as broker

gw --> entrada : HTTP / SOAP
qin --> entrada : ClasificacionGenerada\n(ack manual)
entrada --> pin : llama
pin --> app : implementan\n(con una transaccion\npor caso de uso)
app --> dom : usa
app --> pout : usa
salida ..> pout : implementan
salida --> db : JPA + Flyway\n(tickets, outbox,\nmensajes_procesados)
salida --> ia : POST /api/clasificaciones\n(timeout 7 s)
salida --> broker : AMQP\n(desde el outbox)

note bottom of dom
  Las dependencias apuntan hacia adentro:
  infrastructure -> application -> domain.
  El dominio no conoce Spring, JPA ni HTTP
  (lo controla DominioSinFrameworksTest).
end note
@enduml
